{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vessellayer.org/schema/0.1.0/stream-validity-ownership.schema.json",
  "title": "VesselLayer stream-validity ownership conformance vectors",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schemaVersion", "provenance", "schedule", "vectors"],
  "properties": {
    "$schema": {
      "const": "https://vessellayer.org/schema/0.1.0/stream-validity-ownership.schema.json"
    },
    "schemaVersion": { "const": "0.1.0" },
    "provenance": { "type": "string", "minLength": 1 },
    "schedule": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "vectors": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "negativeAt", "otherAt", "delayedAt", "negativeAfterOther", "reconcile"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "negativeAt": { "$ref": "#/$defs/receiptTime" },
          "otherAt": { "$ref": "#/$defs/receiptTime" },
          "delayedAt": { "$ref": "#/$defs/receiptTime" },
          "negativeAfterOther": { "type": "boolean" },
          "reconcile": { "type": "boolean" }
        }
      }
    }
  },
  "$defs": {
    "receiptTime": {
      "description": "Host monotonic UInt64 units, leaving one unit for the recovery observation.",
      "type": "integer",
      "minimum": 0,
      "maximum": 18446744073709551614
    }
  }
}
