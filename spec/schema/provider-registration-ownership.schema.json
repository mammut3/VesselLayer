{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vessellayer.org/schema/0.1.0/provider-registration-ownership.schema.json",
  "title": "VesselLayer provider-registration ownership conformance vectors",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schemaVersion", "provenance", "schedule", "vectors"],
  "properties": {
    "$schema": {
      "const": "https://vessellayer.org/schema/0.1.0/provider-registration-ownership.schema.json"
    },
    "schemaVersion": { "const": "0.1.0" },
    "provenance": { "type": "string", "minLength": 1 },
    "schedule": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "vectors": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "operation", "replacement", "targetInitiallyPresent", "expected"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "operation": { "enum": ["withdraw", "reconcileSame", "reconcileDifferent"] },
          "replacement": { "enum": ["source", "target"] },
          "targetInitiallyPresent": { "type": "boolean" },
          "expected": { "const": "stateAndRegistrationsUnchangedAfterOldCompletion" }
        }
      }
    }
  }
}
