{
  "$schema": "https://vessellayer.org/schema/0.1.0/conformance-vector.schema.json",
  "schemaVersion": "0.1.0",
  "vectors": [
    {
      "id": "registration-valid-observation",
      "events": [
        {
          "type": "register",
          "providerID": "a"
        },
        {
          "type": "present",
          "providerID": "a"
        },
        {
          "type": "observe",
          "providerID": "a",
          "value": 1.0
        }
      ],
      "policy": {
        "freshForSeconds": 5,
        "providerRanks": {}
      },
      "expectedProviderID": "a",
      "expectedReason": "onlyEligible"
    },
    {
      "id": "stable-tie-break",
      "events": [
        {
          "type": "register",
          "providerID": "b"
        },
        {
          "type": "present",
          "providerID": "b"
        },
        {
          "type": "observe",
          "providerID": "b",
          "value": 2.0
        },
        {
          "type": "register",
          "providerID": "a"
        },
        {
          "type": "present",
          "providerID": "a"
        },
        {
          "type": "observe",
          "providerID": "a",
          "value": 1.0
        }
      ],
      "policy": {
        "freshForSeconds": 5,
        "providerRanks": {}
      },
      "expectedProviderID": "a",
      "expectedReason": "stableProviderID"
    },
    {
      "id": "freshness-failover",
      "events": [
        {
          "type": "register",
          "providerID": "preferred"
        },
        {
          "type": "present",
          "providerID": "preferred"
        },
        {
          "type": "observe",
          "providerID": "preferred",
          "value": 1.0
        },
        {
          "type": "advance",
          "seconds": 4
        },
        {
          "type": "register",
          "providerID": "fallback"
        },
        {
          "type": "present",
          "providerID": "fallback"
        },
        {
          "type": "observe",
          "providerID": "fallback",
          "value": 2.0
        },
        {
          "type": "advance",
          "seconds": 2
        }
      ],
      "policy": {
        "freshForSeconds": 5,
        "providerRanks": {
          "preferred": 0,
          "fallback": 1
        }
      },
      "expectedProviderID": "fallback",
      "expectedReason": "onlyEligible"
    },
    {
      "id": "withdrawal",
      "events": [
        {
          "type": "register",
          "providerID": "a"
        },
        {
          "type": "present",
          "providerID": "a"
        },
        {
          "type": "observe",
          "providerID": "a",
          "value": 1.0
        },
        {
          "type": "withdraw",
          "providerID": "a"
        }
      ],
      "policy": {
        "freshForSeconds": 5,
        "providerRanks": {}
      },
      "expectedProviderID": null,
      "expectedReason": "noEligibleCandidates"
    },
    {
      "id": "provisional-reconciliation",
      "events": [
        {
          "type": "register",
          "providerID": "session"
        },
        {
          "type": "present",
          "providerID": "session"
        },
        {
          "type": "observe",
          "providerID": "session",
          "value": 1.0
        },
        {
          "type": "reconcile",
          "providerID": "session",
          "targetProviderID": "durable"
        }
      ],
      "policy": {
        "freshForSeconds": 5,
        "providerRanks": {}
      },
      "expectedProviderID": "durable",
      "expectedReason": "onlyEligible"
    },
    {
      "id": "obsolete-provider-removal",
      "events": [
        {
          "type": "register",
          "providerID": "session"
        },
        {
          "type": "present",
          "providerID": "session"
        },
        {
          "type": "observe",
          "providerID": "session",
          "value": 1.0
        },
        {
          "type": "remove",
          "providerID": "session"
        }
      ],
      "policy": {
        "freshForSeconds": 5,
        "providerRanks": {}
      },
      "expectedProviderID": null,
      "expectedReason": "noRegisteredCandidates"
    },
    {
      "id": "older-completion",
      "events": [
        {
          "type": "register",
          "providerID": "a"
        },
        {
          "type": "present",
          "providerID": "a"
        },
        {
          "type": "advance",
          "seconds": 4
        },
        {
          "type": "observe",
          "providerID": "a",
          "value": 1.0,
          "receivedAtSeconds": 4
        },
        {
          "type": "observe",
          "providerID": "a",
          "value": 2.0,
          "receivedAtSeconds": 1
        }
      ],
      "policy": {
        "freshForSeconds": 5,
        "providerRanks": {}
      },
      "expectedProviderID": "a",
      "expectedReason": "onlyEligible",
      "expectedValue": 1.0
    },
    {
      "id": "equal-timestamp-arrival-order",
      "events": [
        {
          "type": "register",
          "providerID": "a"
        },
        {
          "type": "present",
          "providerID": "a"
        },
        {
          "type": "advance",
          "seconds": 4
        },
        {
          "type": "observe",
          "providerID": "a",
          "value": 1.0,
          "receivedAtSeconds": 4
        },
        {
          "type": "observe",
          "providerID": "a",
          "value": 2.0,
          "receivedAtSeconds": 4
        }
      ],
      "policy": {
        "freshForSeconds": 5,
        "providerRanks": {}
      },
      "expectedProviderID": "a",
      "expectedReason": "onlyEligible",
      "expectedValue": 2.0
    },
    {
      "id": "negative-validity-retires-without-receipt-refresh",
      "events": [
        {
          "type": "register",
          "providerID": "a"
        },
        {
          "type": "present",
          "providerID": "a"
        },
        {
          "type": "observe",
          "providerID": "a",
          "receivedAtSeconds": 1,
          "value": 1
        },
        {
          "type": "invalidate",
          "providerID": "a",
          "receivedAtSeconds": 2
        }
      ],
      "policy": {
        "freshForSeconds": 5,
        "providerRanks": {}
      },
      "expectedProviderID": null,
      "expectedReason": "noEligibleCandidates"
    },
    {
      "id": "invalid-first-reconcile-rejects-delayed-measurement",
      "events": [
        {
          "type": "register",
          "providerID": "a"
        },
        {
          "type": "present",
          "providerID": "a"
        },
        {
          "type": "invalidate",
          "providerID": "a",
          "receivedAtSeconds": 2
        },
        {
          "type": "reconcile",
          "providerID": "a",
          "targetProviderID": "b"
        },
        {
          "type": "observe",
          "providerID": "b",
          "receivedAtSeconds": 1,
          "value": 1
        }
      ],
      "policy": {
        "freshForSeconds": 5,
        "providerRanks": {}
      },
      "expectedProviderID": null,
      "expectedReason": "noRegisteredCandidates"
    }
  ]
}
